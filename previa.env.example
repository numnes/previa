# Public URLs for the previa dashboard / API behind nginx (or a reverse proxy).
# Copy to previa.env and edit — this file is NOT overwritten by `previa restart`.
#
#   cp previa.env.example previa.env
#
# Leave unset (or omit this file) for local-only defaults:
#   CORS → http://localhost:<web-port>
#   Web build → NEXT_PUBLIC_API_URL=http://localhost:<api-port>

# Browser Origin of the dashboard (written to api/.env as CORS_ORIGIN)
PREVIA_PUBLIC_WEB_URL=https://previa.example.com

# Public API URL baked into the web image (NEXT_PUBLIC_API_URL)
# Use a path if the API is mounted under nginx, e.g. https://host/api
PREVIA_PUBLIC_API_URL=https://previa.example.com/api

# Optional: Next.js basePath when the UI is not at the site root (e.g. /previa)
# PREVIA_PUBLIC_WEB_BASE_PATH=/previa

# Optional: pin host ports so `previa restart` does not reassign them (nginx stays valid).
# If set and the port is busy, setup fails instead of picking another port.
# PREVIA_API_PORT=3002
# PREVIA_WEB_PORT=3001
# PREVIA_POSTGRES_PORT=5432
# PREVIA_REDIS_PORT=6480

# Optional: version label in the dashboard sidebar (defaults to `git describe --tags`)
# PREVIA_VERSION=v0.2.10

# Optional: how many deploy/destroy jobs run in parallel (default 3).
# Slot limit (max active instances) is still enforced atomically before each deploy starts.
# PREVIA_DEPLOY_CONCURRENCY=3

# Optional: where preview checkouts live. Default on setup/restart is
# $HOME/.local/share/deployer (if that directory exists) or $HOME/.local/share/previa.
# PREVIA_WORK_ROOT=/var/lib/previa
