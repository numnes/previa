#!/usr/bin/env bash
# previa CLI — wrapper for scripts in scripts/
set -euo pipefail

resolve_previa_root() {
  if [[ -n "${PREVIA_ROOT:-${DEPLOYER_ROOT:-}}" ]]; then
    echo "${PREVIA_ROOT:-$DEPLOYER_ROOT}"
    return
  fi
  if [[ -f "${HOME}/.config/previa/root" ]]; then
    cat "${HOME}/.config/previa/root"
    return
  fi
  if [[ -f "${HOME}/.config/deployer/root" ]]; then
    cat "${HOME}/.config/deployer/root"
    return
  fi
  local script
  script="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  if [[ -z "$script" ]]; then
    script="${BASH_SOURCE[0]}"
  fi
  local dir
  dir="$(cd "$(dirname "$script")/.." && pwd)"
  echo "$dir"
}

ROOT="$(resolve_previa_root)"

if [[ ! -d "$ROOT/scripts" ]]; then
  echo "previa: invalid install directory: $ROOT" >&2
  echo "Set PREVIA_ROOT or reinstall with scripts/install.sh" >&2
  exit 1
fi

cmd="${1:-help}"
shift || true

confirm_down() {
  if [[ "${PREVIA_YES:-${DEPLOYER_YES:-}}" == "1" || "${1:-}" == "-y" || "${1:-}" == "--yes" ]]; then
    return 0
  fi
  echo ""
  echo "⚠  This will shut down Previa:"
  echo "   • API (PM2: previa-api)"
  echo "   • Docker containers (Postgres, Redis, Web)"
  echo ""
  read -r -p "Continue? [y/N] " ans
  if [[ ! "$ans" =~ ^[yY]$ ]]; then
    echo "Cancelled."
    exit 0
  fi
}

case "$cmd" in
  setup)
    sub="${1:-}"
    if [[ "$sub" == "nginx" ]]; then
      shift
      exec bash "${ROOT}/scripts/setup-nginx.sh" "$@"
    fi
    exec bash "${ROOT}/scripts/dev-up.sh" "$@"
    ;;
  up|start)
    exec bash "${ROOT}/scripts/dev-up.sh" "$@"
    ;;
  down|stop)
    confirm_down "$@"
    exec bash "${ROOT}/scripts/dev-down.sh" "$@"
    ;;
  restart)
    confirm_down "$@"
    bash "${ROOT}/scripts/dev-down.sh"
    exec bash "${ROOT}/scripts/dev-up.sh" "$@"
    ;;
  status)
    echo "=== Previa ($ROOT) ==="
    ENV_FILE="${ROOT}/api/.env"
    PUBLIC_ENV="${ROOT}/previa.env"
    if [[ ! -f "$PUBLIC_ENV" && -f "${ROOT}/deployer.env" ]]; then
      PUBLIC_ENV="${ROOT}/deployer.env"
    fi
    if [[ -f "$ENV_FILE" ]]; then
      api_port="$(grep -E '^PORT=' "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '[:space:]')"
      cors="$(grep -E '^CORS_ORIGIN=' "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '[:space:]')"
      pg_port="$(grep -E '^DATABASE_URL=' "$ENV_FILE" 2>/dev/null | tail -1 | sed -n 's/.*:\([0-9]*\)\/\(previa\|deployer\).*/\1/p')"
      redis_port="$(grep -E '^REDIS_PORT=' "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '[:space:]')"
      echo ""
      echo "Ports (from api/.env):"
      echo "  API:      ${api_port:-?}"
      echo "  Postgres: ${pg_port:-?}"
      echo "  Redis:    ${redis_port:-?}"
      echo "  CORS:     ${cors:-?}"
    fi
    if [[ -f "$PUBLIC_ENV" ]]; then
      echo ""
      echo "previa.env:"
      grep -E '^PREVIA_(PUBLIC_|API_PORT|WEB_PORT|POSTGRES_PORT|REDIS_PORT)|^DEPLOYER_(PUBLIC_|API_PORT|WEB_PORT|POSTGRES_PORT|REDIS_PORT)' "$PUBLIC_ENV" 2>/dev/null | sed 's/^/  /' || true
    else
      echo ""
      echo "previa.env: (absent — localhost defaults + auto ports)"
      echo "  Tip: cp previa.env.example previa.env"
    fi
    echo ""
    echo "Docker:"
    if docker ps -a --filter 'name=previa-' --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | grep -q previa; then
      docker ps -a --filter 'name=previa-' --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    elif docker ps -a --filter 'name=deployer-' --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | grep -q deployer; then
      docker ps -a --filter 'name=deployer-' --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    else
      echo "  (no previa-* containers)"
    fi
    echo ""
    echo "PM2:"
    if command -v pm2 >/dev/null 2>&1; then
      pm2 describe previa-api 2>/dev/null | grep -E 'status|name|script path' \
        || pm2 describe deployer-api 2>/dev/null | grep -E 'status|name|script path' \
        || echo "  previa-api is not running"
    else
      npx --yes pm2 describe previa-api 2>/dev/null | grep -E 'status|name|script path' || echo "  previa-api is not running"
    fi
    ;;
  logs)
    target="${1:-api}"
    case "$target" in
      api)
        if command -v pm2 >/dev/null 2>&1; then
          exec pm2 logs previa-api --lines 100
        else
          exec npx --yes pm2 logs previa-api --lines 100
        fi
        ;;
      web|front)
        if docker inspect previa-web >/dev/null 2>&1; then
          exec docker logs -f --tail 100 previa-web
        fi
        exec docker logs -f --tail 100 deployer-web
        ;;
      *)
        echo "Usage: previa logs [api|web]" >&2
        exit 1
        ;;
    esac
    ;;
  update|pull)
    echo "[previa] Updating repository at $ROOT..."
    git -C "$ROOT" pull --ff-only
    previa_in_path="$(command -v previa 2>/dev/null || true)"
    if [[ -n "$previa_in_path" ]]; then
      export PREVIA_BIN_DIR="$(dirname "$previa_in_path")"
    fi
    bash "${ROOT}/scripts/sync-cli.sh"
    # shellcheck source=../scripts/lib/public-env.sh
    source "${ROOT}/scripts/lib/public-env.sh"
    # shellcheck source=../scripts/lib/work-root.sh
    source "${ROOT}/scripts/lib/work-root.sh"
    load_previa_public_env "$ROOT"
    previa_sync_work_root_env "$ROOT" >/dev/null
    if command -v pm2 >/dev/null 2>&1; then
      pm2 restart previa-api --update-env >/dev/null 2>&1 \
        || pm2 restart deployer-api --update-env >/dev/null 2>&1 \
        || true
    fi
    echo "[previa] OK — executable, scripts, and PREVIA_WORK_ROOT updated"
    ;;
  project)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      init|setup)
        exec bash "${ROOT}/scripts/project-init.sh" "$@"
        ;;
      help|-h|--help)
        exec bash "${ROOT}/scripts/project-init.sh" --help
        ;;
      *)
        echo "previa: unknown project command: $sub" >&2
        echo "Run: previa project init --help" >&2
        exit 1
        ;;
    esac
    ;;
  root|path)
    echo "$ROOT"
    ;;
  help|-h|--help)
    cat <<EOF
previa — local Previa stack management

Usage: previa <command> [options]

Stack:
  setup, up, start     Start Postgres, Redis, web (Docker) and API (PM2)
  down, stop           Stop API and containers (asks for confirmation)
  restart              down + setup (asks for confirmation)
  status               Show ports, Docker containers, and PM2 API
  logs [api|web]       Follow API (PM2) or web (Docker) logs
  update, pull         git pull + refresh CLI, rewrite PREVIA_WORK_ROOT, restart API
  root, path           Print install directory

Project:
  project init [PATH]  Copy GitHub Actions + previa.yaml into an app repo
  project init --help  Options: -f/--force, --branches

nginx:
  setup nginx          Print sites-enabled config with locations include (manual edit)
  setup nginx --help   Options: -f/--file, -s/--sites-dir

Global:
  help                 Show this help

Options:
  down/restart -y, --yes   Skip confirmation
  PREVIA_YES=1           Same as above

Install: curl -fsSL .../scripts/install.sh | bash
Directory: $ROOT
Docs: README.md in the install directory
EOF
    ;;
  *)
    echo "previa: unknown command: $cmd" >&2
    echo "Run: previa help" >&2
    exit 1
    ;;
esac
