PORT=3000
DATABASE_URL=postgresql://postgres:deployer@localhost:5432/deployer
TYPEORM_SYNC=true
JWT_SECRET=troque-em-producao

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# ou: REDIS_URL=redis://127.0.0.1:6379

# Core
PREVIA_WORK_ROOT=/home/previa/.local/share/previa
PREVIA_CORE_DIR=/home/previa/previa/core

# Chave root-only para endpoints privilegiados (register / listar usuários).
# Gerada automaticamente no `previa setup`. Enviada no header X-Previa-Setup-Key.
PREVIA_SETUP_KEY=troque-em-producao

# Chave local para criptografar credenciais de nós remotos no Postgres.
# Gerada automaticamente pelo setup; mantenha estável entre restarts.
PREVIA_CLUSTER_SECRET=troque-em-producao

# CORS — prefer previa.env (PREVIA_PUBLIC_WEB_URL); setup keeps non-local values
# Ex.: CORS_ORIGIN=https://previa.seudominio.com
CORS_ORIGIN=http://localhost:3001

